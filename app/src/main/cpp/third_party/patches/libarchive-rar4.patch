+  rar->solid_marker_pending = 0;
+  rar->solid_ready = read_member_end(a) == ARCHIVE_OK;
+  if (!rar->solid_ready) /* the member itself is fine; the next one will say */
+    archive_clear_error(&a->archive);
+}
