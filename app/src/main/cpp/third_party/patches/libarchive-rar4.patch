+/* value's low byte as a signed number */
+static inline int
+rar20_signed_byte(int value)
+{
+  value &= 0xFF;
+  return (value >= 0x80 ? value - 0x100 : value);
+}
+
+/*
+ * Reads a block header: a bit for audio or LZ, a bit to add the new code lengths to the
+ * last ones rather than to zeros, for audio two bits of channel count, then the code
+ * lengths, themselves coded by a code of 19 symbols.
+ */
+static int
+parse_codes20(struct archive_read *a)
+{
+  struct rar *rar = a->format->data;
+  struct rar_br *br = &(rar->br);
+  struct huffman_code precode;
+  unsigned char bitlengths[RAR20_PRECODE_SIZE];
+  unsigned char *table = rar->v20.lengthtable;
+  int i, j, n, val, size, r;
+
+  free_codes(a);
+  memset(&precode, 0, sizeof(precode));
+
+  if (!rar_br_read_ahead(a, br, 2))
+    goto truncated_data;
+  rar->v20.audio = rar_br_bits(br, 1);
+  rar_br_consume(br, 1);
+  if (!rar_br_bits(br, 1))
+    memset(table, 0, RAR20_TABLE_SIZE);
+  rar_br_consume(br, 1);
+
+  size = RAR20_LZ_TABLE_SIZE;
+  if (rar->v20.audio)
+  {
+    if (!rar_br_read_ahead(a, br, 2))
+      goto truncated_data;
+    rar->v20.channels = rar_br_bits(br, 2) + 1;
+    rar_br_consume(br, 2);
+    if (rar->v20.channel >= rar->v20.channels)
+      rar->v20.channel = 0;
+    size = RAR20_AUDIOCODE_SIZE * rar->v20.channels;
+  }
+
+  for (i = 0; i < RAR20_PRECODE_SIZE; i++)
+  {
+    if (!rar_br_read_ahead(a, br, 4))
+      goto truncated_data;
+    bitlengths[i] = rar_br_bits(br, 4);
+    rar_br_consume(br, 4);
+  }
+  if ((r = create_code(a, &precode, bitlengths, RAR20_PRECODE_SIZE,
+      MAX_SYMBOL_LENGTH)) != ARCHIVE_OK)
+    goto failed;
+
+  for (i = 0; i < size;)
+  {
+    if ((val = read_next_symbol(a, &precode)) < 0)
+    {
+      archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+                        "Bad RAR file data");
+      r = ARCHIVE_FAILED;
+      goto failed;
+    }
+    if (val < 16)
+    {
+      table[i] = (table[i] + val) & 0xF;
+      i++;
+    }
+    else if (val == 16)
+    {
+      /* The length before, 3 to 6 times */
+      if (i == 0)
+      {
+        archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+                          "Bad RAR file data");
+        r = ARCHIVE_FAILED;
+        goto failed;
+      }
+      if (!rar_br_read_ahead(a, br, 2))
+        goto truncated_data;
+      n = rar_br_bits(br, 2) + 3;
+      rar_br_consume(br, 2);
+      for (j = 0; j < n && i < size; j++, i++)
+        table[i] = table[i - 1];
+    }
+    else
+    {
+      /* Zeros, 3 to 10 or 11 to 138 of them */
+      if (val == 17)
+      {
+        if (!rar_br_read_ahead(a, br, 3))
+          goto truncated_data;
+        n = rar_br_bits(br, 3) + 3;
+        rar_br_consume(br, 3);
+      }
+      else
+      {
+        if (!rar_br_read_ahead(a, br, 7))
+          goto truncated_data;
+        n = rar_br_bits(br, 7) + 11;
+        rar_br_consume(br, 7);
+      }
+      for (j = 0; j < n && i < size; j++)
+        table[i++] = 0;
+    }
+  }
+  free(precode.tree);
+  free(precode.table);
+
+  if (rar->v20.audio)
+  {
+    for (i = 0; i < rar->v20.channels; i++)
+      if ((r = create_code(a, &rar->v20.audiocode[i], &table[i * RAR20_AUDIOCODE_SIZE],
+          RAR20_AUDIOCODE_SIZE, MAX_SYMBOL_LENGTH)) != ARCHIVE_OK)
+        return (r);
+  }
+  else
+  {
+    if ((r = create_code(a, &rar->maincode, table, RAR20_MAINCODE_SIZE,
+        MAX_SYMBOL_LENGTH)) != ARCHIVE_OK)
+      return (r);
+    if ((r = create_code(a, &rar->offsetcode, &table[RAR20_MAINCODE_SIZE],
+        RAR20_OFFSETCODE_SIZE, MAX_SYMBOL_LENGTH)) != ARCHIVE_OK)
+      return (r);
+    if ((r = create_code(a, &rar->lengthcode,
+        &table[RAR20_MAINCODE_SIZE + RAR20_OFFSETCODE_SIZE],
+        RAR20_LENGTHCODE_SIZE, MAX_SYMBOL_LENGTH)) != ARCHIVE_OK)
+      return (r);
+  }
+  if ((r = allocate_window(a)) != ARCHIVE_OK)
+    return (r);
+  rar->start_new_table = 0;
+  return (ARCHIVE_OK);
+
+truncated_data:
+  archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+                    "Truncated RAR file data");
+  rar->valid = 0;
+  r = ARCHIVE_FAILED;
+failed:
+  free(precode.tree);
+  free(precode.table);
+  return (r);
+}
+
+/* The next byte of an audio block, from the coded difference to the predicted one. */
+static uint8_t
+decode_audio20(struct rar *rar, int delta)
+{
+  struct rar20_channel *v = &rar->v20.state[rar->v20.channel];
+  int predicted, byte, error, i, best;
+
+  v->count++;
+  v->delta[3] = v->delta[2];
+  v->delta[2] = v->delta[1];
+  v->delta[1] = v->lastdelta - v->delta[0];
+  v->delta[0] = v->lastdelta;
+  predicted = 8 * v->lastbyte + v->weight[0] * v->delta[0] +
+    v->weight[1] * v->delta[1] + v->weight[2] * v->delta[2] +
+    v->weight[3] * v->delta[3] + v->weight[4] * rar->v20.channel_delta;
+  /* The sum can be negative; shifted unsigned, its low byte is that of floor(sum / 8). */
+  predicted = (int)(((unsigned int)predicted >> 3) & 0xFF);
+  byte = predicted - delta;
+
+  /* Each weight moves towards the predictions that would have erred least. */
+  error = rar20_signed_byte(delta) * 8;
+  v->error[0] += abs(error);
+  v->error[1] += abs(error - v->delta[0]);
+  v->error[2] += abs(error + v->delta[0]);
+  v->error[3] += abs(error - v->delta[1]);
+  v->error[4] += abs(error + v->delta[1]);
+  v->error[5] += abs(error - v->delta[2]);
+  v->error[6] += abs(error + v->delta[2]);
+  v->error[7] += abs(error - v->delta[3]);
+  v->error[8] += abs(error + v->delta[3]);
+  v->error[9] += abs(error - rar->v20.channel_delta);
+  v->error[10] += abs(error + rar->v20.channel_delta);
+
+  rar->v20.channel_delta = v->lastdelta = rar20_signed_byte(byte - v->lastbyte);
+  v->lastbyte = byte;
+
+  if ((v->count & 0x1F) == 0)
+  {
+    best = 0;
+    for (i = 1; i < 11; i++)
+      if (v->error[i] < v->error[best])
+        best = i;
+    memset(v->error, 0, sizeof(v->error));
+    if (best > 0)
+    {
+      i = (best - 1) / 2;
+      if ((best - 1) % 2 == 0)
+      {
+        if (v->weight[i] >= -16)
+          v->weight[i]--;
+      }
+      else if (v->weight[i] < 16)
+        v->weight[i]++;
+    }
+  }
+  return ((uint8_t)byte);
+}
+
+/* expand() for RAR 2.0: decodes LZ and audio blocks into the window until it reaches *end. */
+static int
+expand20(struct archive_read *a, int64_t *end)
+{
+  struct rar *rar = a->format->data;
+  struct rar_br *br = &(rar->br);
+  int symbol, lensymbol, offssymbol, i, r;
+  unsigned int offs, len;
+
+  while (lzss_position(&rar->lzss) < *end)
+  {
+    if (rar->v20.audio)
+    {
+      if ((symbol = read_next_symbol(a, &rar->v20.audiocode[rar->v20.channel])) < 0)
+        goto bad_data;
+      if (symbol == 256)
+      {
+        /* The end of the block; another header follows. */
+        if ((r = parse_codes20(a)) != ARCHIVE_OK)
+          return (r);
+        continue;
+      }
+      lzss_emit_literal(rar, decode_audio20(rar, symbol));
+      if (++rar->v20.channel >= rar->v20.channels)
+        rar->v20.channel = 0;
+      continue;
+    }
+
+    if ((symbol = read_next_symbol(a, &rar->maincode)) < 0)
+      goto bad_data;
+    if (symbol < 256)
+    {
+      lzss_emit_literal(rar, (uint8_t)symbol);
+      continue;
+    }
+    if (symbol == 269)
+    {
+      /* The end of the block; another header follows. */
+      if ((r = parse_codes20(a)) != ARCHIVE_OK)
+        return (r);
+      continue;
+    }
+    if (symbol == 256)
+    {
+      /* The last match again */
+      offs = rar->oldoffset[0];
+      len = rar->lastlength;
+    }
+    else if (symbol < 261)
+    {
+      /* One of the last four offsets, with a new length, longer for a longer offset */
+      offs = rar->oldoffset[symbol - 257];
+      if ((lensymbol = read_next_symbol(a, &rar->lengthcode)) < 0)
+        goto bad_data;
+      if (lensymbol >= lengthb_min)
+        goto bad_data;
+      len = lengthbases[lensymbol] + 2;
+      if (lengthbits[lensymbol] > 0)
+      {
+        if (!rar_br_read_ahead(a, br, lengthbits[lensymbol]))
+          goto truncated_data;
+        len += rar_br_bits(br, lengthbits[lensymbol]);
+        rar_br_consume(br, lengthbits[lensymbol]);
+      }
+      if (offs >= 0x101)
+        len++;
+      if (offs >= 0x2000)
+        len++;
+      if (offs >= 0x40000)
+        len++;
+    }
+    else if (symbol < 269)
+    {
+      /* Two bytes from up to 256 back */
+      i = symbol - 261;
+      offs = shortbases[i] + 1;
+      if (!rar_br_read_ahead(a, br, shortbits[i]))
+        goto truncated_data;
+      offs += rar_br_bits(br, shortbits[i]);
+      rar_br_consume(br, shortbits[i]);
+      len = 2;
+    }
+    else
+    {
+      /* A new length and offset */
+      i = symbol - 270;
+      if (i >= lengthb_min)
+        goto bad_data;
+      len = lengthbases[i] + 3;
+      if (lengthbits[i] > 0)
+      {
+        if (!rar_br_read_ahead(a, br, lengthbits[i]))
+          goto truncated_data;
+        len += rar_br_bits(br, lengthbits[i]);
+        rar_br_consume(br, lengthbits[i]);
+      }
+      if ((offssymbol = read_next_symbol(a, &rar->offsetcode)) < 0)
+        goto bad_data;
+      if (offssymbol >= RAR20_OFFSETCODE_SIZE)
+        goto bad_data;
+      offs = offsetbases[offssymbol] + 1;
+      if (offsetbits[offssymbol] > 0)
+      {
+        if (!rar_br_read_ahead(a, br, offsetbits[offssymbol]))
+          goto truncated_data;
+        offs += rar_br_bits(br, offsetbits[offssymbol]);
+        rar_br_consume(br, offsetbits[offssymbol]);
+      }
+      if (offs >= 0x2000)
+        len++;
+      if (offs >= 0x40000)
+        len++;
+    }
+
+    /* Every match pushes its offset onto the last four, even one taken from them. */
+    rar->oldoffset[3] = rar->oldoffset[2];
+    rar->oldoffset[2] = rar->oldoffset[1];
+    rar->oldoffset[1] = rar->oldoffset[0];
+    rar->oldoffset[0] = offs;
+    rar->lastlength = len;
+    lzss_emit_match(rar, (int)offs, (int)len);
+  }
+  return (ARCHIVE_OK);
+
+truncated_data:
+  archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+                    "Truncated RAR file data");
+  rar->valid = 0;
+  return (ARCHIVE_FAILED);
+bad_data:
+  archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+                    "Bad RAR file data");
+  return (ARCHIVE_FAILED);
+}
+
+/*
+ * Reads what a RAR 2.0 member's data holds after its last byte, which the next solid
+ * member depends on: when the first member is empty, the tables the next ones start with;
+ * when an empty member comes before one that needs other codes, the end of the block and
+ * a new header. Anything else past the last symbol is padding.
+ */
+static int
+read_member_end20(struct archive_read *a)
+{
+  struct rar *rar = a->format->data;
+  struct rar_br *br = &(rar->br);
+  int symbol, ret;
+
+  if (!br->next_in && (ret = rar_br_preparation(a, br)) < ARCHIVE_WARN)
+    return (ret);
+  if (rar->start_new_table)
+  {
+    if (br->cache_avail == 0 && rar->bytes_remaining == 0)
+      return (ARCHIVE_OK); /* the next member starts with them */
+    if ((ret = parse_codes20(a)) != ARCHIVE_OK)
+      return (ret);
+  }
+  while (br->cache_avail + 8 * rar->bytes_remaining > RAR20_TAIL_PADDING)
+  {
+    symbol = read_next_symbol(a, rar->v20.audio ?
+      &rar->v20.audiocode[rar->v20.channel] : &rar->maincode);
+    if (symbol != (rar->v20.audio ? 256 : 269))
+    {
+      archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+                        "Bad RAR file data");
+      return (ARCHIVE_FAILED);
+    }
+    if ((ret = parse_codes20(a)) != ARCHIVE_OK)
+      return (ret);
+  }
+  return (ARCHIVE_OK);
+}
